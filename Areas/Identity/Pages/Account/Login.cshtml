@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="auth-page mt-3">
    <div class="auth-card">
        <div class="row g-0">
            <div class="col-md-5">
                <div class="auth-intro d-flex flex-column justify-content-center">
                    <h3>Welcome Back</h3>
                    <p class="mb-0">Sign in to continue shopping, track your orders, and manage your account.</p>
                </div>
            </div>
            <div class="col-md-7">
                <div class="auth-card-body">
                    <h2 class="mb-2">Log in</h2>
                    <p class="text-muted mb-3">Use your account credentials.</p>
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="form-label">Password</label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                        <div class="checkbox mb-3">
                            <label asp-for="Input.RememberMe" class="form-label">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>
                        <button id="login-submit" type="submit" class="w-100 btn btn-primary auth-submit mb-3">Log in</button>
                        <div class="small">
                            <p class="mb-1"><a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a></p>
                            <p class="mb-1"><a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create a new account</a></p>
                            <p class="mb-0"><a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a></p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
