@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="auth-page mt-3">
    <div class="auth-card">
        <div class="auth-card-body text-center">
            <h2 class="mb-3">@ViewData["Title"]</h2>
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <p class="text-muted mb-3">Are you sure you want to sign out?</p>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                    <button type="submit" class="btn btn-danger auth-submit px-4">Sign out now</button>
                </form>
            }
            else
            {
                <p class="mb-3">You have successfully logged out of the application.</p>
                <a asp-controller="Store" asp-action="Index" class="btn btn-primary auth-submit px-4">Continue Shopping</a>
            }
        </div>
    </div>
</div>
