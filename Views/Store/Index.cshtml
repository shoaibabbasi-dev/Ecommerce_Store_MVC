@model EcommerceMvcStore.ViewModels.ProductListViewModel
@{
    ViewData["Title"] = "Store";
}

<section class="hero-banner">
    <h1>Find What You Love</h1>
    <p>Explore trending products, top categories, and exclusive daily deals.</p>
</section>

<section class="panel mb-4">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label mb-1">Search</label>
            <input class="form-control" name="q" value="@Model.SearchTerm" placeholder="Search products..." />
        </div>
        <div class="col-md-4">
            <label class="form-label mb-1">Category</label>
            <select class="form-select" name="categoryId">
                <option value="">All Categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id" selected="@(Model.SelectedCategoryId == category.Id)">@category.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-primary w-100">Apply Filters</button>
        </div>
    </form>
</section>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Product Catalog</h4>
    <span class="badge text-bg-dark">@Model.Products.Count() items</span>
</div>

<div class="row g-4">
    @foreach (var item in Model.Products)
    {
        <div class="col-md-3">
            <div class="card product-card h-100">
                <img src="@item.ImageUrl" class="card-img-top product-image" alt="@item.Name" />
                <div class="card-body d-flex flex-column">
                    <h6 class="mb-1">@item.Name</h6>
                    <p class="small text-muted mb-2">@item.Category?.Name</p>
                    <p class="price-tag mb-3">$@item.Price</p>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm mt-auto">View Details</a>
                </div>
            </div>
        </div>
    }
</div>
