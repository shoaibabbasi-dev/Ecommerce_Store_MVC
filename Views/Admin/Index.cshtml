@{
    ViewData["Title"] = "Product Admin Dashboard";
    var recentProducts = ViewBag.RecentProducts as List<EcommerceMvcStore.Models.Ecommerce.Product> ?? new();
}

<section class="admin-hero mb-4">
    <div>
        <h2 class="mb-1">Product Management Dashboard</h2>
        <p class="mb-0">Manage catalog inventory, pricing, and product availability.</p>
    </div>
</section>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="admin-stat-card">
            <p class="admin-stat-title">Total Products</p>
            <h3>@ViewBag.ProductCount</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-stat-card">
            <p class="admin-stat-title">Active Products</p>
            <h3>@ViewBag.ActiveProducts</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-stat-card">
            <p class="admin-stat-title">Inactive Products</p>
            <h3>@ViewBag.InactiveProducts</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-stat-card">
            <p class="admin-stat-title">Low Stock</p>
            <h3>@ViewBag.LowStockCount</h3>
        </div>
    </div>
</div>

<div class="admin-panel mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-1">Pending Orders</h5>
            <p class="text-muted mb-0">Orders waiting for fulfillment update.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <h4 class="mb-0">@ViewBag.PendingOrders</h4>
            <a asp-action="Orders" class="btn btn-sm btn-outline-primary">Open Orders</a>
        </div>
    </div>
</div>

<div class="admin-panel mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-1">Catalog Overview</h5>
            <p class="text-muted mb-0">Categories available:</p>
        </div>
        <h4 class="admin-revenue mb-0">@ViewBag.CategoryCount</h4>
    </div>
</div>

<div class="admin-panel mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Quick Actions</h5>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Products" class="btn btn-primary">Manage Products</a>
        <a asp-action="CreateProduct" class="btn btn-success">Add New Product</a>
        <a asp-action="Orders" class="btn btn-outline-primary">Manage Orders</a>
    </div>
</div>

<div class="admin-panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Recently Added Products</h5>
        <a asp-action="Products" class="btn btn-sm btn-outline-secondary">View All</a>
    </div>

    @if (recentProducts.Count == 0)
    {
        <p class="text-muted mb-0">No products found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in recentProducts)
                    {
                        <tr>
                            <td>@product.Name</td>
                            <td>@product.Category?.Name</td>
                            <td>$@product.Price</td>
                            <td>@product.StockQuantity</td>
                            <td>@(product.IsActive ? "Active" : "Inactive")</td>
                            <td><a asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
