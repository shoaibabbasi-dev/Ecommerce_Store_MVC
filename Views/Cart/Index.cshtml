@model List<EcommerceMvcStore.Models.Ecommerce.CartItem>
@{
    ViewData["Title"] = "Your Cart";
    var total = Model.Sum(x => x.LineTotal);
}

<h2 class="mb-3">Shopping Cart</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Your cart is empty.</div>
    <a asp-controller="Store" asp-action="Index" class="btn btn-primary">Continue Shopping</a>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product</th>
                <th style="width:120px;">Price</th>
                <th style="width:160px;">Quantity</th>
                <th style="width:120px;">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>$@item.UnitPrice</td>
                    <td>
                        <form asp-action="Update" method="post" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="number" name="quantity" value="@item.Quantity" min="0" class="form-control" />
                            <button class="btn btn-sm btn-outline-secondary">Update</button>
                        </form>
                    </td>
                    <td>$@item.LineTotal</td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="mb-3">Grand Total: $@total</h4>
    <div class="d-flex gap-2">
        <a asp-controller="Orders" asp-action="Checkout" class="btn btn-success">Proceed to Checkout</a>
        <form asp-action="Clear" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-danger">Clear Cart</button>
        </form>
    </div>
}
